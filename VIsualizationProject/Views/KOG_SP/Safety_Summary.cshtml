@model List<VIsualizationProject.Models.Safety_Summary>
@{
    ViewBag.Title = "Safety_Summary";
}

<style>
    body {
        background: #f2f4f6;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .sidebar {
        height: calc(100vh - 64px);
        overflow-y: auto;
        width: 260px;
        position: fixed;
        top: 0;
        left: 0;
        background: #fff;
        color: #000000;
        overflow-x: hidden;
        transition: width 0.3s;
        z-index: 1000;
        margin-top: 64px;
        border-right: 1px solid #e5e5e5;
        box-shadow: 1px 0 6px rgba(0,0,0,0.03);
    }

    .dropdown-list {
        max-height: 600px;
        overflow-y: auto;
    }

    .sidebar .sidebar-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 20px 18px 8px 22px;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 1px;
        background: #fff;
        color: #000000;
        border-bottom: 1px solid #f4f4f6;
    }

    .sidebar .dropdown-group {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .sidebar .dropdown {
        margin: 0 0 2px 0;
    }

    .sidebar .dropdown-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px 14px 18px;
        cursor: pointer;
        font-size: 1.11rem;
        font-weight: 500;
        color: #000000;
        background: #fff;
        border-radius: 10px;
        border: 1px solid transparent;
        transition: background 0.15s, border 0.15s, color 0.15s;
    }

        .sidebar .dropdown-header:hover,
        .sidebar .dropdown.open .dropdown-header {
            background: #800000;
            color: #fff;
            border: 1px solid #800000;
        }

    .sidebar .dropdown-list {
        background: #e8edf2;
        border-radius: 0 0 10px 10px;
        padding: 10px 0 6px 0;
        display: none;
        flex-direction: column;
        gap: 2px;
    }

    .sidebar .dropdown.open .dropdown-list {
        display: flex;
    }

    .sidebar .dropdown-list a {
        padding: 7px 28px;
        color: #000000;
        text-decoration: none;
        font-size: 1.04rem;
        border-radius: 4px;
        font-weight: 500;
        transition: background 0.17s;
        width: 100%;
        box-sizing: border-box;
    }

        .sidebar .dropdown-list a:hover {
            background: #d3dbe7;
        }

    .top-navbar {
        width: 100%;
        height: 64px;
        background: #800000;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1050;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        padding: 0 32px;
    }

        .top-navbar .navbar-brand {
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: 1px;
            color: #fff;
            text-decoration: none;
        }

        .top-navbar .navbar-links {
            display: flex;
            gap: 32px;
            align-items: center;
        }

            .top-navbar .navbar-links a {
                color: #fff;
                text-decoration: none;
                font-size: 1.1rem;
                font-weight: 500;
                transition: color 0.2s;
            }

                .top-navbar .navbar-links a:hover {
                    color: #ffd700;
                }

    .container-announcements {
        margin-top: 80px;
        margin-left: 170px;
        padding: 32px;
        width: calc(100vw - 260px);
        max-width: 1300px;
        min-width: 350px;
        min-height: calc(100vh - 80px);
        box-sizing: border-box;
        transition: margin-left 0.3s, width 0.3s;
    }

    .announcements-header {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 32px 38px 28px 38px;
        margin-bottom: 18px;
    }

    .header-titles h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #000000;
        margin: 0 0 10px 0;
    }

    .header-titles .breadcrumb {
        font-size: 1.1rem;
        color: #616176;
        font-weight: 500;
    }

        .header-titles .breadcrumb a {
            color: #2f38e6;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.13s;
        }

            .header-titles .breadcrumb a:hover {
                color: #1a2163;
                text-decoration: none;
            }

    .add-announcement-btn {
        background: #000;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 14px 32px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

        .add-announcement-btn:hover {
            background: #333;
        }

    .announcements-main {
        background: #f5f6f8;
        border-radius: 15px;
        padding: 28px 20px 38px 14px;
        box-shadow: 0 1px 8px rgba(0,0,0,0.05);
    }

        .announcements-main h2 {
            text-align: center;
            color: #000000;
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 28px;
        }

    .announcements-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0 auto 36px auto;
        font-size: 1.1rem;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 8px rgba(0,0,0,0.05);
    }

        .announcements-table thead tr {
            background: #800000;
            color: #fff;
        }

        .announcements-table th, .announcements-table td {
            padding: 9px 22px;
            text-align: left;
        }

        .announcements-table th {
            font-weight: 500;
            font-size: 0.9rem;
            letter-spacing: 1px;
            border-bottom: 2px solid #fff2d6;
        }

        .announcements-table tbody tr:nth-child(even) {
            background: #f4f6fa;
        }

        .announcements-table tbody tr:nth-child(odd) {
            background: #fdfcff;
        }

        .announcements-table td {
            font-weight: 400;
            font-size: 1.0rem;
            color: #2a2a3a;
            border-bottom: 1px solid #e7e7ef;
        }

            .announcements-table td:last-child,
            .announcements-table th:last-child {
                text-align: center;
            }

    .icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        outline: none;
        padding: 0;
    }

    .top-navbar .icon-btn {
        margin-right: 24px;
        margin-left: 12px;
    }

    .custom-hamburger-icon {
        width: 48px;
        height: 48px;
        background: #f5f6f6;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 1px 6px rgba(0,0,0,0.10);
    }

    .custom-hamburger-icon-inner {
        width: 32px;
        height: 32px;
        background: #f6f7f7;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 0 transparent;
        position: relative;
    }

    .custom-hamburger-bar {
        width: 24px;
        height: 5px;
        background: #23224a;
        border-radius: 3px;
        margin: 3px 0;
    }

    media (max-width: 900px) {
        sidebar

    {
        position: static;
        width: 100%;
        height: auto;
        box-shadow: none;
        border-right: none;
        padding-top: 0;
    }

    .container-announcements {
        margin-left: 0;
        width: 100vw;
        padding: 10px;
    }

    media (max-width: 700px) {
        announcements-header

    {
        flex-direction: column;
        align-items: flex-start;
        padding: 10px 10px;
    }

    .announcements-main {
        padding: 2px 2px 24px 2px;
    }

    .announcements-table th, .announcements-table td {
        padding: 10px 6px;
        font-size: 1rem;
    }

    .announcements-table-yellow thead tr {
        background: #d2ad0e;
        color: #fff;
    }

    .announcements-table-yellow th {
        font-weight: 700;
        font-size: 1.11rem;
        letter-spacing: 1px;
        border-bottom: 2px solid #fff2d6;
        text-align: left;
    }

    .announcements-table-yellow td {
        font-weight: 500;
        color: #222246;
        border-bottom: 1px solid #e7e7ef;
        background: #f4f6f8;
    }

    .announcements-table-yellow td,
    .announcements-table-yellow th {
        padding: 16px 18px;
        text-align: left;
    }

    .announcements-table-yellow .edit-link {
        color: #1561e7;
        text-decoration: underline;
        font-weight: 700;
        cursor: pointer;
    }

    .announcements-table-yellow .delete-link {
        color: #e01b1b;
        text-decoration: underline;
        font-weight: 700;
        cursor: pointer;
    }
</style>

<div class="top-navbar">
    <button class="icon-btn" id="sidebarHideBtn" title="Hide Sidebar" aria-label="Hide Sidebar">
        <div class="custom-hamburger-icon">
            <div class="custom-hamburger-icon-inner">
                <div class="custom-hamburger-bar"></div>
                <div class="custom-hamburger-bar"></div>
                <div class="custom-hamburger-bar"></div>
            </div>
        </div>
    </button>
    <a href="#" class="navbar-brand">Production  Visualization</a>
    <div class="navbar-links">
        <a href="@Url.Action("Dashboard", "KOG_SP")">Dashboard</a>
        <a href="@Url.Action("Login", "Acc")">Logout</a>
    </div>
</div>

<div class="sidebar" id="mainSidebar">
    <div class="sidebar-header" style="cursor:pointer;" onclick="window.location.href='/KOG_SP/Dashboard'">
        <span class="sidebar-home-icon">&#8962;</span>
        <span>KGG</span>
    </div>
    <ul class="dropdown-group">
        <li>
            <div class="dropdown" id="dropdownRS1">
                <div class="dropdown-header">
                    <span class="dropdown-icon-svg">
                        <svg width="22" height="22" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="8" width="24" height="16" rx="3" fill="none" stroke="#222246" stroke-width="2" />
                            <line x1="13" y1="19" x2="19" y2="13" stroke="#222246" stroke-width="2" stroke-linecap="round" />
                            <circle cx="20.3" cy="11.7" r="1.1" fill="#222246" />
                        </svg>
                    </span>
                    <span class="dropdown-header-text">SP</span>
                    <span class="arrow">&#8964;</span>
                </div>
                <div class="dropdown-list">
                    <a href="@Url.Action("All_Charts", "KOG_SP")"><span>&#8211;</span> All Charts</a>
                    <a href="@Url.Action("Output", "KOG_SP")"><span>&#8211;</span> OutPut</a>
                    <a href="@Url.Action("Attendance", "KOG_SP")"><span>&#8211;</span> Attendance</a>
                    <a href="@Url.Action("Birthday", "KOG_SP")"><span>&#8211;</span> Birthday</a>
                    <a href="@Url.Action("", "KOG_SP")"><span>&#8211;</span> Delivery Performance</a>
                    <a href="@Url.Action("five_s", "KOG_SP")"><span>&#8211;</span> 5S Achievement</a>
                    <a href="@Url.Action("SP_OGQC", "KOG_SP")"><span>&#8211;</span> OGQC</a>
                    <a href=@Url.Action("MonthlyPP", "KOG_SP")><span>&#8211;</span> Monthly PP</a>
                    <a href="@Url.Action("Announcements", "KOG_SP")"><span>&#8211;</span> Announcements</a>
                    <a href="@Url.Action("", "KOG_SP")"><span>&#8211;</span> Rework Cost</a>
                    <a href="@Url.Action("Safety_Summary", "KOG_SP")"><span>&#8211;</span> Safety Summary</a>
                    <a href="@Url.Action("LayOut", "KOG_SP")"><span>&#8211;</span> LayOut</a>
                </div>
            </div>
        </li>
    </ul>
</div>

<div class="container-announcements">
    <div class="announcements-header">
        <div class="header-titles">
            <h1>Safety Summary</h1>
            <div class="breadcrumb">
                SP KGG &gt; <a href="#">Safety Summary</a>
            </div>
        </div>
        <button class="add-announcement-btn" onclick="window.location.href='/KOG_SP/Add_SafetySummary'">Add Safety Summary</button>
    </div>

    <div class="announcements-main">
        <h2 style="text-align:center; color:#222246; font-size:2rem; font-weight:800; margin:40px 0 22px 0;">Safety Summary</h2>
        <table class="announcements-table announcements-table-yellow">
            <thead>
                <tr>
                    <th>Injury Date</th>
                    <th>Employee Name</th>
                    <th>Description</th>
                    <th>Injury Status</th>
                    <th>Edit</th>
                    
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Date.ToString("dd, MMMM, yyyy")</td>
                            <td>@item.Employee_Name</td>
                            <td>@item.Description</td>
                            <td>@item.Injury_status</td>
                            <td>
                                <a href="#" class="edit-link" data-id="@item.Id">Edit</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center;">No records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


</div>

<div class="modal fade" id="editSafetyModal" tabindex="-1" aria-labelledby="editSafetyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editSafetyForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editSafetyModalLabel">Edit Safety Summary</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                            style="border:none;background:transparent;font-size:2rem;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editId" name="Id" />
                    <div class="form-group">
                        <label for="editDate">Injury Date</label>
                        <input type="date" class="form-control" id="editDate" name="Date" required>
                    </div>
                    <div class="form-group">
                        <label for="editEmployeeName">Employee Name</label>
                        <input type="text" class="form-control" id="editEmployeeName" name="Employee_Name" required>
                    </div>
                    <div class="form-group">
                        <label for="editDescription">Description</label>
                        <input type="text" class="form-control" id="editDescription" name="Description" required>
                    </div>
                    <div class="form-group">
                        <label for="editInjuryStatus">Injury Status</label>
                        <input type="text" class="form-control" id="editInjuryStatus" name="Injury_status" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    document.querySelectorAll('.dropdown').forEach(function (dropdown) {
        const header = dropdown.querySelector('.dropdown-header');
        header.addEventListener('click', function () {
            dropdown.classList.toggle('open');
        });
    });

    const sidebar = document.getElementById('mainSidebar');
    const sidebarHideBtn = document.getElementById('sidebarHideBtn');

    let sidebarVisible = true;


    sidebarHideBtn.addEventListener('click', function () {
        if (sidebarVisible) {
            sidebar.style.display = 'none';
            document.querySelector('.container-announcements').style.marginLeft = '0';
            document.querySelector('.container-announcements').style.width = '100vw';
        } else {
            sidebar.style.display = 'block';
            document.querySelector('.container-announcements').style.marginLeft = '190px';
            document.querySelector('.container-announcements').style.width = 'calc(100vw - 260px)';
        }
        sidebarVisible = !sidebarVisible;
    });
    
   $(function () {
    $(document).on('click', '.edit-link', function (e) {
        e.preventDefault();
        var id = $(this).data('id');
        $.get('@Url.Action("Get_SafetySummary", "KOG_SP")', { id: id }, function (data) {
            if (data) {
                $('#editId').val(data.Id);
                $('#editDate').val(data.Date);
                $('#editEmployeeName').val(data.Employee_Name);
                $('#editDescription').val(data.Description);
                $('#editInjuryStatus').val(data.Injury_status);
                $('#editSafetyModal').modal('show');
            }
        });
    });

    $('#editSafetyForm').submit(function (e) {
        e.preventDefault();
        var form = $(this);
        $.ajax({
            url: '@Url.Action("Edit_SafetySummary", "KOG_SP")',
            type: 'POST',
            data: form.serialize(),
            success: function (res) {
                if (res.success) {
                    $('#editSafetyModal').modal('hide');
                    location.reload();
                } else {
                    alert(res.error || 'Update failed');
                }
            },
            error: function () {
                alert('Update failed');
            }
        });
    });

    $('#editSafetyModal .close, #editSafetyModal .btn-secondary').on('click', function () {
        $('#editSafetyModal').modal('hide');
    });
});
</script>

