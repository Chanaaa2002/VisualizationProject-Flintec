@using System
@using System.Collections.Generic
@model IEnumerable<VIsualizationProject.Models.Announcement>
@{
    Layout = null;
    ViewBag.Title = "All Charts";
    var safetyDates = ViewBag.SafetyDates as List<string>;
    var today = DateTime.Today;
    int year = today.Year;
    int month = today.Month;
    int daysInMonth = DateTime.DaysInMonth(year, month);
    var monthName = today.ToString("MMMM");
    var posts = Model?.Where(a => a.Start_Date <= today && a.End_Date >= today)
                  .OrderByDescending(a => a.Date)
                  .ToList() ?? new List<VIsualizationProject.Models.Announcement>();
    var birthdaysToday = ViewBag.BirthdaysToday as List<VIsualizationProject.Models.Birthdays>;
    var rotateDelay = 5000;
    int slideIdx = 2;
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    body, html {
        height: 100%;
        margin: 0;
        padding: 0;
        background: url("https://img.freepik.com/free-vector/red-wavy-with-halftone-background_1409-1274.jpg?semt=ais_hybrid&w=740&q=80") no-repeat center center fixed;
        background-size: cover;
    }
    /*Safety Summary Styles*/
    .screen-slide {
        width: 100vw;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
        transition: opacity 0.7s;
        opacity: 0;
        pointer-events: none;
        background: transparent;
    }

        .screen-slide.active {
            opacity: 1;
            pointer-events: auto;
            z-index: 10;
        }

    .container, .row {
        min-height: 100vh;
        display: flex !important;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .calendar-container {
        max-width: 600px;
        width: 98vw;
        margin: 28px auto 0 auto;
        border-radius: 26px;
        background: #ffff;
        box-shadow: 0 6px 32px 0 rgba(0,0,0,0.09);
        padding: 38px 28px 28px 28px;
        position: relative;
        background-image: #f8f9fa;
        background-size: cover;
        background-repeat: no-repeat;
        box-sizing: border-box;
        transition: max-width 0.2s, padding 0.2s;
    }

    .calendar-header {
        text-align: center;
        font-size: 2.45rem;
        font-weight: 800;
        color: #991313;
        margin-bottom: 16px;
        letter-spacing: 1.7px;
        word-break: break-word;
    }

    .calendar-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        flex-wrap: wrap;
        gap: 8px;
    }

        .calendar-nav button {
            background: #991313;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 1.18rem;
            font-weight: 700;
            padding: 10px 28px;
            cursor: pointer;
            transition: background 0.18s;
            box-shadow: 0 2px 8px 0 rgba(153, 19, 19, 0.10);
            margin: 0 8px;
            white-space: nowrap;
        }

            .calendar-nav button:hover {
                background: #b71c1c;
            }

    #calendarMonthLabel {
        font-size: 1.18rem;
        font-weight: 700;
        letter-spacing: 0.7px;
        color: #232323;
        text-align: center;
        flex: 1;
        min-width: 140px;
        margin: 0 8px;
    }

    .safety-legend {
        display: flex;
        gap: 22px;
        align-items: center;
        justify-content: center;
        margin: 21px 0 17px 0;
        flex-wrap: wrap;
    }

        .safety-legend span {
            font-size: 1.07rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .safety-legend .legend-box {
            display: inline-block;
            width: 28px;
            height: 15px;
            border-radius: 4px;
            margin-right: 4px;
            vertical-align: middle;
        }

        .safety-legend .legend-red {
            background: #e74c3c;
        }

        .safety-legend .legend-green {
            background: #27ae60;
        }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 56px);
        grid-auto-rows: 56px;
        gap: 18px;
        justify-content: center;
        margin-top: 8px;
        margin-bottom: 0;
        width: 100%;
        box-sizing: border-box;
        overflow-x: auto;
        transition: grid-template-columns 0.2s, gap 0.2s;
    }

    .calendar-day {
        text-align: center;
        line-height: 56px;
        font-weight: 800;
        font-size: 1.22rem;
        color: #404050;
        background: #f1f3f6;
        border-radius: 12px;
        margin-bottom: 2px;
        letter-spacing: 0.8px;
        box-shadow: none;
        border: none;
        word-break: break-word;
    }

    .calendar-cell {
        text-align: center;
        vertical-align: middle;
        font-size: 1.22rem;
        font-weight: 700;
        border-radius: 14px;
        transition: box-shadow 0.20s, border 0.20s, font-size 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: none;
        border: none;
        margin: 0;
        cursor: pointer;
        background: #27ae60;
        color: #fff;
        word-break: break-word;
    }

        .calendar-cell.red {
            background: #e74c3c;
            color: #fff;
        }

        .calendar-cell.green {
            background: #27ae60;
            color: #fff;
        }

        .calendar-cell.today {
            border: 3px solid #232f3e;
            box-shadow: 0 2px 8px 0 rgba(60,60,60,0.14);
            z-index: 2;
        }

        .calendar-cell.empty {
            background: none !important;
            box-shadow: none !important;
            border: none !important;
            cursor: default;
            pointer-events: none;
        }

