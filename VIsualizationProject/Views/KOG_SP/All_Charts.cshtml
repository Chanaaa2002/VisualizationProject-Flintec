<div class="container">
    <div class="row">
        @*Safety summary Slide *@
        <div id="safety-calendar" class="screen-slide active">
            <div class="calendar-container">
                <div class="calendar-header">Safety Calendar</div>
                <div class="calendar-nav">
                    <button onclick="changeMonth(-1)">&#8592; Prev</button>
                    <span id="calendarMonthLabel">@monthName @year</span>
                    <button onclick="changeMonth(1)">Next &#8594;</button>
                </div>
                <div class="safety-legend">
                    <span>
                        <span class="legend-box legend-red"></span>
                        <span style="font-size:0.9rem;color:#5b5b5b;font-weight:600;">Incident Day</span>
                    </span>
                    <span>
                        <span class="legend-box legend-green"></span>
                        <span style="font-size:0.9rem;color:#5b5b5b;font-weight:600;">Safe Day</span>
                    </span>
                </div>
                <div class="calendar-grid" id="calendarGrid">
                    <div class="calendar-day">Sun</div>
                    <div class="calendar-day">Mon</div>
                    <div class="calendar-day">Tue</div>
                    <div class="calendar-day">Wed</div>
                    <div class="calendar-day">Thu</div>
                    <div class="calendar-day">Fri</div>
                    <div class="calendar-day">Sat</div>
                    @{
                        int firstDay = (int)(new DateTime(year, month, 1).DayOfWeek);
                        for (int i = 0; i < firstDay; i++)
                        {
                            <div class="calendar-cell empty"></div>
                        }
                        for (int day = 1; day <= daysInMonth; day++)
                        {
                            var dateStr = new DateTime(year, month, day).ToString("yyyy-MM-dd");
                            var colorClass = safetyDates != null && safetyDates.Contains(dateStr) ? "red" : "green";
                            var isToday = (year == DateTime.Today.Year && month == DateTime.Today.Month && day == DateTime.Today.Day) ? "today" : "";
                            <div class="calendar-cell @colorClass @isToday">@day</div>
                        }
                    }
                </div>
            </div>
        </div>
        <!-- Announcements Slide -->
        <div id="announcements-container" class="screen-slide">
            <div class="announcements-grid">
                <div class="announcements-header">
                    <h2>All Announcements</h2>
                </div>
                @if (posts != null && posts.Any())
                {
                    <div class="announcements-grid-container">
                        @foreach (var post in posts)
                        {
                            <div class="announcement-card" id="announcement-@post.Id" data-announcement-id="@post.Id">
                                <div class="announcement-header">
                                    <div class="announcement-icon">📢</div>
                                    <div class="announcement-title">Announcement </div>
                                </div>
                                <div class="announcement-content">@post.Publisher_Post</div>
                                <div class="announcement-footer">
                                    <span class="announcement-date">@post.Date.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-announcements">
                        <div class="no-announcements-icon">📭</div>
                        <h3>No Active Announcements</h3>
                        <p>There are currently no active announcements to display.</p>
                    </div>
                }
            </div>
        </div>
        @*Birthday Slide  *@
        <div id="birthday-slide" class="screen-slide">
            <div class="birthday-post-box">
                <div class="birthday-happy-title">HAPPY<br>BIRTHDAY</div>
                @if (birthdaysToday != null && birthdaysToday.Any())
                {
                    <div class="birthday-grid-container">
                        @foreach (var b in birthdaysToday)
                        {
                            <div class="birthday-card">
                                <div class="birthday-photo-frame">
                                    @if (b.Photo != null)
                                    {
                                        <img src="@Url.Action("GetBirthdayPhoto", "KOG_SP", new { id = b.Id })" alt="Birthday Photo" />
                                    }
                                    else
                                    {
                                        <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" alt="No Photo" />
                                    }
                                </div>
                                <div class="birthday-info">
                                    <div class="birthday-name">Wishing you a Happy birthday @b.Name</div>
                                    @*<div class="birthday-employee">@b.Employee_Number</div>*@
                                    @*<div class="birthday-date">@b.Date.ToString("dd MMMM, yyyy")</div>*@
                                    <div class="birthday-wish" style="font-size: 1.3rem; color: #FFFFFF; font-weight: 400; margin: 10px 0 8px 0; ">
                                        May your special day be filled with good Health and happiness<br />
                                        Have a wonderful year ahead!
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="birthday-post-content">No Birthdays Today!</div>
                }
            </div>
        </div>
        @*Layout Slide *@
        <div id="layout-slide" class="screen-slide">
            <div class="layout-post-box">
                <div class="layout-title">PRODUCTION<br>LAYOUT</div>
                @if (ViewBag.LatestLayout != null)
                {
                    <div class="layout-info">
                        <div class="layout-details">
                            <span class="layout-label">Production Line:</span>
                            <span class="layout-value">@ViewBag.LatestLayout.Production_Line</span>
                        </div>
                        <div class="layout-details">
                            <span class="layout-label">Location:</span>
                            <span class="layout-value">@ViewBag.LatestLayout.Location</span>
                        </div>
                        <div class="layout-details">
                            <span class="layout-label">Date:</span>
                            <span class="layout-value">@ViewBag.LatestLayout.Date.ToString("dd MMMM, yyyy")</span>
                        </div>
                    </div>
                    <div class="layout-image-container">
                        <img src="@Url.Action("GetLayoutImage", "KOG_SP", new { id = ViewBag.LatestLayout.Id })"
                             alt="Production Layout"
                             class="layout-image" />
                    </div>
                }
                else
                {
                    <div class="layout-no-data">
                        <div class="layout-no-data-icon">🏭</div>
                        <h3>No Layout Available</h3>
                        <p>No production layout has been uploaded for the current production line and location.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Logo in the top-right corner -->
<img src="/Content/images/logo2.png" id="corner-logo" alt="Logo" />


<script>
    var safetyDates = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(safetyDates ?? new List<string>()));
    let currentYear = @year;
    let currentMonth = @month;
    function changeMonth(delta) {
        currentMonth += delta;
        if (currentMonth > 12) { currentMonth = 1; currentYear++; }
        if (currentMonth < 1) { currentMonth = 12; currentYear--; }
        renderCalendar(currentYear, currentMonth);
    }
    function renderCalendar(year, month) {
        let daysInMonth = new Date(year, month, 0).getDate();
        let firstDay = new Date(year, month-1, 1).getDay();
        let grid = document.getElementById('calendarGrid');
        let html = "";
        let days = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
        for (let d = 0; d < 7; d++) {
            html += `<div class="calendar-day">${days[d]}</div>`;
        }
        for (let i = 0; i < firstDay; i++) {
            html += `<div class="calendar-cell empty"></div>`;
        }
        for (let day = 1; day <= daysInMonth; day++) {
            let dateStr = year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
            let colorClass = safetyDates.includes(dateStr) ? "red" : "green";
            let isToday = (year == new Date().getFullYear() && month == (new Date().getMonth()+1) && day == new Date().getDate()) ? "today" : "";
            html += `<div class="calendar-cell ${colorClass} ${isToday}">${day}</div>`;
        }
        grid.innerHTML = html;
        const monthNames = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];
        document.getElementById('calendarMonthLabel').innerText = monthNames[month - 1] + " " + year;
    }
    renderCalendar(currentYear, currentMonth);

     // Slide logic: toggle between safety summary and announcements
    var slides = [
        document.getElementById('safety-calendar'),
        document.getElementById('announcements-container'),
        document.getElementById('birthday-slide'),
        document.getElementById('layout-slide'),
    ];
    var current = 0;
    function rotateSlides() {
        slides.forEach(s => s.classList.remove('active'));
        slides[current].classList.add('active');
        current = (current + 1) % slides.length;
        setTimeout(rotateSlides, @rotateDelay);
    }
    // Start slide show when ready
    document.addEventListener('DOMContentLoaded', function() {
        rotateSlides();
    });
    // All Charts Page: Restore Announcement Display State from localStorage

    function restoreAnnouncementStates() {
        document.querySelectorAll('.announcement-card').forEach(card => {
            const announcementId = card.id.replace('announcement-', '');
            const isEnabled = localStorage.getItem('showPublisher_' + announcementId);

            if (isEnabled === 'false') {
                // Hide the announcement completely
                card.style.display = 'none';
            } else {
                // Show the announcement
                card.style.display = 'block';
            }
        });

        // Optional: Show "No Announcements" message if all are hidden
        var anyVisible = Array.from(document.querySelectorAll('.announcement-card'))
            .some(card => card.style.display !== "none");
        var noAnnouncementsDiv = document.querySelector('.no-announcements');
        if (noAnnouncementsDiv) {
            noAnnouncementsDiv.style.display = anyVisible ? "none" : "";
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        restoreAnnouncementStates();
    });
</script>