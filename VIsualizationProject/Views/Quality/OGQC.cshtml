@model List<VIsualizationProject.Models.OGQC>
@{
    ViewBag.Title = "OGQC";
}

<style>
    body {
        background: #f2f4f6;
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .top-navbar {
        width: 100%;
        height: 64px;
        background: #222246;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1050;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        padding: 0 32px;
    }

    .top-navbar .navbar-brand {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #fff;
        text-decoration: none;
    }

    .top-navbar .navbar-links {
        display: flex;
        gap: 32px;
        align-items: center;
    }

    .top-navbar .navbar-links a {
        color: #fff;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 500;
        transition: color 0.2s;
    }

    .top-navbar .navbar-links a:hover {
        color: #ffd700;
    }

    .container-announcements {
        margin-top: 80px;
        margin-left: auto;
        margin-right: auto;
        padding: 32px 16px;
        width: 100%;
        max-width: 1200px;
        min-width: 350px;
        min-height: calc(100vh - 80px);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
    }

    .announcements-header {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 32px 38px 28px 38px;
        margin-bottom: 18px;
        width: 100%;
        max-width: 900px;
    }

    .header-titles h1 {
        font-size: 1.6rem;
        font-weight: 700;
        color: #222246;
        margin: 0 0 10px 0;
    }

    .header-titles .breadcrumb {
        font-size: 1.1rem;
        color: #616176;
        font-weight: 500;
    }

    .header-titles .breadcrumb a {
        color: #2f38e6;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.13s;
    }

    .header-titles .breadcrumb a:hover {
        color: #1a2163;
        text-decoration: none;
    }

    .add-announcement-btn {
        background: #000;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: 14px 32px;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }

    .add-announcement-btn:hover {
        background: #333;
    }

    .announcements-main {
        background: #f5f6f8;
        border-radius: 15px;
        padding: 28px 20px 38px 14px;
        box-shadow: 0 1px 8px rgba(0,0,0,0.05);
        margin: 0 auto;
        width: 100%;
        max-width: 900px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .announcements-main h2 {
        text-align: center;
        color: #262654;
        font-size: 1.7rem;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 28px;
    }

    .announcements-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0 auto 36px auto;
        font-size: 1.1rem;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 8px rgba(0,0,0,0.05);
    }

    .announcements-table thead tr {
        background: #ffa600;
        color: #fff;
    }

    .announcements-table th, .announcements-table td {
        padding: 9px 22px;
        text-align: left;
    }

    .announcements-table th {
        font-weight: 500;
        font-size: 0.9rem;
        letter-spacing: 1px;
        border-bottom: 2px solid #fff2d6;
    }

    .announcements-table tbody tr:nth-child(even) {
        background: #f4f6fa;
    }

    .announcements-table tbody tr:nth-child(odd) {
        background: #fdfcff;
    }

    .announcements-table td {
        font-weight: 400;
        font-size: 1.0rem;
        color: #2a2a3a;
        border-bottom: 1px solid #e7e7ef;
    }

    .announcements-table td:last-child,
    .announcements-table th:last-child {
        text-align: center;
    }

   media (max-width: 900px) {
        .container-announcements,
        .announcements-header,
        .announcements-main {
            max-width: 100vw;
            width: 100vw;
            padding-left: 8px;
            padding-right: 8px;
        }
    }

    media (max-width: 700px) {
        .announcements-header {
            flex-direction: column;
            align-items: flex-start;
            padding: 10px 10px;
        }

        .announcements-main {
            padding: 2px 2px 24px 2px;
        }

        .announcements-table th, .announcements-table td {
            padding: 10px 6px;
            font-size: 1rem;
        }
    
</style>

<div class="top-navbar">
    <a href="#" class="navbar-brand">Production Visualization</a>
    <div class="navbar-links">
        <a href="@Url.Action("OGQC_Chart", "Quality")">Dashboard</a>
        <a href="#">Logout</a>
    </div>
</div>

<div class="container-announcements">
    <div class="announcements-header">
        <div class="header-titles">
            <h1>OGQC</h1>
            <div class="breadcrumb">
                SP KGG &gt; <a href="#">OGQC</a>
            </div>
        </div>
        <button class="add-announcement-btn" onclick="window.location.href='/Quality/AddOGQC'">Add OGQC</button>
    </div>

    <div class="announcements-main">
        <h2>OGQC Summary</h2>
        <table class="announcements-table announcements-table-yellow">
            <thead>
                <tr>
                    <th>Detected Date</th>
                    <th>Product</th>
                    <th>Lot Size</th>
                    <th>Defect Qty</th>
                    <th>Production Line</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Detected_Date.ToString("dd, MMMM, yyyy")</td>
                            <td>@item.Product</td>
                            <td>@item.Lot_Size</td>
                            <td>@item.Defect_Qty</td>
                            <td>@item.Production_Line</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center;">No records found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    document.querySelectorAll('.dropdown').forEach(function (dropdown) {
        const header = dropdown.querySelector('.dropdown-header');
        header.addEventListener('click', function () {
            dropdown.classList.toggle('open');
        });
    });
    const sidebar = document.getElementById('mainSidebar');
    const sidebarHideBtn = document.getElementById('sidebarHideBtn');

    let sidebarVisible = true;

    sidebarHideBtn.addEventListener('click', function () {
        if (sidebarVisible) {
            sidebar.style.display = 'none';
            document.querySelector('.container-announcements').style.marginLeft = '0';
            document.querySelector('.container-announcements').style.width = '100vw';
        } else {
            sidebar.style.display = 'block';
            document.querySelector('.container-announcements').style.marginLeft = '190px';
            document.querySelector('.container-announcements').style.width = 'calc(100vw - 260px)';
        }
        sidebarVisible = !sidebarVisible;
    });    
</script>



